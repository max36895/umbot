benchmark/comparison/node_modules/*
benchmark/comparison/package-lock.json
# baseline.json — JIT-метрики машины CI; создаётся npm run baseline:update
# на той же машине, где гоняется ночной baseline:check (см. BENCHMARKS.md).
benchmark/comparison/baseline.json

# Временные песочницы аудита/профилировки: сгенерированные CLI-проекты и
# отладочные скрипты — не исходники umbot (lint их не проверяет).
/audit/*
/tmp-surgery/*

# Артефакты тестов (FileAdapter-таблицы, логи) — см. tests/helpers/tmpDir.ts
/tests/.tmp/

# live-test: локальные токены и артефакты прогона
/live-test/.env
/live-test/.tmp/

# .claude/skills — связь с .agents/skills (единственный источник скилов).
# Claude Code читает скилы только из .claude/skills, поэтому связь создаётся
# автоматически при `npm i` (хук prepare -> scripts/link-skills.js).
.claude/

# Перевод документации: рабочие файлы и сборка (scripts/i18n-docs.js), в git — только кэш и настройки
/i18n/*/pending.*
/i18n/*/build/
