{
    "name": "umbot",
    "version": "3.1.3",
    "description": "Мультиплатформенный фреймворк для создания голосовых навыков и чат-ботов с единой бизнес-логикой. Встроенная поддержка ВКонтакте, Telegram, Viber, MAX, Яндекс Алисы, Маруси и Сбера SmartApp. Архитектура на адаптерах позволяет подключать любые другие платформы без изменения основного кода.",
    "keywords": [
        "vk",
        "vkontakte",
        "telegram",
        "viber",
        "max",
        "yandex-alice",
        "alice",
        "marusia",
        "sber",
        "smartapp",
        "salute",
        "алиса",
        "яндекс",
        "маруся",
        "сбер",
        "салют",
        "вконтакте",
        "framework",
        "chatbot",
        "bot",
        "voice-skill",
        "voice-assistant",
        "cross-platform",
        "typescript",
        "бот",
        "чат-бот",
        "голосовой-навык",
        "голосовой-ассистент",
        "фреймворк",
        "мультиплатформенный",
        "навык",
        "umbot",
        "universal-bot",
        "bot-sdk",
        "dialogs",
        "middleware"
    ],
    "author": {
        "name": "Maxim-M",
        "email": "maximco36895@yandex.ru"
    },
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "commonjs",
    "typesVersions": {
        "*": {
            "test": [
                "./dist/test.d.ts"
            ],
            "preload": [
                "./dist/Preload.d.ts"
            ],
            "build": [
                "./dist/build.d.ts"
            ],
            "plugins": [
                "./dist/plugins.d.ts"
            ],
            "middleware": [
                "./dist/middleware.d.ts"
            ],
            "utils": [
                "./dist/utils/index.d.ts"
            ]
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/max36895/umbot.git"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./build": {
            "types": "./dist/build.d.ts",
            "default": "./dist/build.js"
        },
        "./plugins": {
            "types": "./dist/plugins.d.ts",
            "default": "./dist/plugins.js"
        },
        "./middleware": {
            "types": "./dist/middleware.d.ts",
            "default": "./dist/middleware.js"
        },
        "./utils": {
            "types": "./dist/utils/index.d.ts",
            "default": "./dist/utils/index.js"
        },
        "./test": {
            "types": "./dist/test.d.ts",
            "default": "./dist/test.js"
        },
        "./preload": {
            "types": "./dist/Preload.d.ts",
            "default": "./dist/Preload.js"
        }
    },
    "scripts": {
        "watch": "npm run clean && tsc -watch",
        "start": "npm run clean && tsc",
        "build": "npm run clean && tsc --declaration",
        "bt": "npm run build && npm test",
        "deploy": "npm run build && npm publish",
        "create": "umbot",
        "clean": "node scripts/clean.js",
        "clean:tmp": "node scripts/clean-tmp.js",
        "test": "node --expose-gc ./node_modules/jest/bin/jest.js",
        "test:coverage": "jest --coverage",
        "doc": "typedoc --excludePrivate --excludeExternals",
        "doc:fix": "node scripts/fix-doc.js",
        "prettier": "prettier --write .",
        "lint": "eslint . --ext .ts,.js",
        "lint:fix": "eslint . --ext .ts,.js --fix",
        "typecheck": "tsc --noEmit",
        "check": "npm run doc:fix && npm run prettier && npm run typecheck && npm run lint",
        "bench": "node --expose-gc ./benchmark/command.js",
        "stress": "node --expose-gc ./benchmark/stress-test.js",
        "stress:fb": "node --expose-gc ./benchmark/fb.js",
        "stress:lite": "node --expose-gc ./benchmark/stress-test.js lite",
        "stress:long": "node --expose-gc ./benchmark/stress-test.js long",
        "stress:prof": "node --prof --expose-gc ./benchmark/stress-test.js",
        "comparison": "node --expose-gc ./benchmark/um.js",
        "comparison:logic": "node --expose-gc ./benchmark/um.js logic",
        "audit:load": "node --expose-gc ./scripts/audit-load.js",
        "compare": "node --expose-gc ./benchmark/comparison/telegram.js",
        "compare:alisa": "node --expose-gc ./benchmark/comparison/alisa.js",
        "compare:vk": "node --expose-gc ./benchmark/comparison/vk.js",
        "compare:viber": "node --expose-gc ./benchmark/comparison/viber.js",
        "compare:max": "node --expose-gc ./benchmark/comparison/max.js",
        "stress:compare": "node ./benchmark/comparison/stress.js telegram.js",
        "stress:compare:alisa": "node ./benchmark/comparison/stress.js alisa.js",
        "stress:compare:vk": "node ./benchmark/comparison/stress.js vk.js",
        "stress:compare:viber": "node ./benchmark/comparison/stress.js viber.js",
        "stress:compare:max": "node ./benchmark/comparison/stress.js max.js",
        "baseline:update": "node --expose-gc ./benchmark/comparison/baseline.js update",
        "baseline:check": "node --expose-gc ./benchmark/comparison/baseline.js check",
        "live": "node live-test"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "bugs": {
        "url": "https://github.com/max36895/umbot/issues"
    },
    "bin": {
        "umbot": "cli/umbot.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.19.30",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-security": "^4.0.0",
        "globals": "^17.4.0",
        "jest": "^30.3.0",
        "mongodb": "^7.1.1",
        "prettier": "^3.8.1",
        "ts-jest": "^29.4.9",
        "typedoc": "^0.28.18",
        "typescript-eslint": "^8.60.0"
    },
    "peerDependencies": {
        "mongodb": "^7.1.1",
        "typescript": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "typescript": {
            "optional": true
        },
        "mongodb": {
            "optional": true
        }
    },
    "files": [
        "dist",
        "cli"
    ],
    "funding": {
        "type": "individual",
        "url": "https://boosty.to/max36895/donate"
    },
    "maintainers": [
        {
            "name": "max36895",
            "email": "maximco36895@yandex.ru",
            "url": "https://github.com/max36895"
        }
    ]
}
