{
    "entryPoints": [
        "src/index.ts",
        "src/build.ts",
        "cli/index.ts",
        "src/plugins.ts",
        "src/middleware.ts",
        "src/test.ts",
        "src/Preload.ts",
        "src/docs"
    ],
    "cleanOutputDir": true,
    "entryPointStrategy": "resolve",
    "readme": "README.md",
    "projectDocuments": ["src/docs/**/*.md", "cli/README.md"],
    "name": "umbot",
    "out": "./docs/",
    "tsconfig": "tsconfigForDoc.json",
    "excludePrivate": true,
    "excludeExternals": true,
    "excludeInternal": true,
    "excludeReferences": true,
    "theme": "default",
    "includeVersion": true,
    "highlightLanguages": [
        "bash",
        "console",
        "diff",
        "dockerfile",
        "html",
        "http",
        "javascript",
        "json",
        "jsonc",
        "nginx",
        "shell",
        "sql",
        "text",
        "ts",
        "tsx",
        "typescript",
        "yaml"
    ],
    "categorizeByGroup": true,
    "navigation": {
        "includeGroups": true
    },
    "groupOrder": [
        "Основное",
        "Ответ пользователю",
        "Хранение данных",
        "Подключение платформ",
        "Адаптеры платформ",
        "Адаптеры баз данных",
        "Свой адаптер",
        "API платформ",
        "Classes",
        "Functions",
        "Variables",
        "Interfaces",
        "Type Aliases",
        "Enumerations",
        "*",
        "Namespaces"
    ],
    "searchInComments": true,
    "sort": ["kind", "instance-first", "alphabetical"],
    "validation": {
        "invalidLink": true,
        "notDocumented": false
    },
    "lang": "en",
    "navigationLinks": {
        "GitHub": "https://github.com/max36895/umbot",
        "npm": "https://www.npmjs.com/package/umbot"
    },
    "visibilityFilters": {
        "protected": false,
        "private": false,
        "inherited": true,
        "external": false
    }
}
